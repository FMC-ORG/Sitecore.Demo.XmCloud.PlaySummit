{
  "name": "playwebsite",
  "description": "PLAY! Summit XMC rendering host; external integrations are archived",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "config": {
    "appName": "playwebsite",
    "rootPlaceholders": [
      "headless-header",
      "headless-main",
      "headless-footer"
    ],
    "language": "en"
  },
  "author": {
    "name": "Sitecore Demo Solutions Team",
    "url": "https://www.sitecore.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sitecore/Sitecore.Demo.XmCloud.PlaySummit.git"
  },
  "bugs": {
    "url": "https://github.com/Sitecore/Sitecore.Demo.XmCloud.PlaySummit/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-brands-svg-icons": "^5.15.4",
    "@fortawesome/free-regular-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@next/bundle-analyzer": "16.4.1",
    "@sitecore-content-sdk/analytics-core": "2.1.2",
    "@sitecore-content-sdk/events": "2.1.2",
    "@sitecore-content-sdk/nextjs": "2.4.1",
    "@sitecore-content-sdk/personalize": "2.1.0",
    "@sitecore-feaas/clientside": "0.6.4",
    "@sitecore/components": "2.1.2",
    "deep-equal": "^2.0.5",
    "graphql": "16.11.0",
    "html-react-parser": "^5.1.1",
    "lodash": "^4.17.21",
    "next": "16.4.1",
    "next-localization": "0.12.0",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^6.0.1",
    "postcss-sassy-mixins": "^2.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-loading-skeleton": "^3.0.3",
    "sass": "^1.52.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@storybook/nextjs": "10.6.2",
    "@storybook/react": "10.6.2",
    "@sitecore-content-sdk/cli": "2.3.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/deep-equal": "^1.0.1",
    "@types/lodash": "^4.14.178",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "autoprefixer": "^10.4.2",
    "cross-env": "~7.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "^16.0.0",
    "postcss": "^8.4.23",
    "prettier": "3.9.10",
    "storybook": "10.6.2",
    "stylelint": "^13.13.1",
    "stylelint-config-standard": "^22.0.0",
    "tailwindcss": "^3.0.23",
    "typescript": "5.8.3"
  },
  "scripts": {
    "test:baseline": "playwright test --config=playwright.baseline.config.ts",
    "lint:baseline": "eslint playwright.baseline.config.ts tests/baseline/**/*.ts",
    "lint": "npm run eslint && npm run stylelint",
    "eslint": "eslint src sitecore.config.ts sitecore.cli.config.ts sitecore.cli.storybook.config.ts playwright.baseline.config.ts",
    "stylelint": "stylelint ./src/**/*.css",
    "typecheck": "tsc --noEmit",
    "bootstrap": "npm run sitecore-tools:generate-map && npm run sitecore-tools:build",
    "sitecore-tools:generate-map": "sitecore-tools project component generate-map",
    "sitecore-tools:generate-map:watch": "sitecore-tools project component generate-map --watch",
    "sitecore-tools:build": "sitecore-tools project build",
    "build": "cross-env NODE_ENV=production npm run bootstrap && npm run next:build",
    "build:local": "npm run build",
    "next:build": "next build --webpack",
    "next:dev": "next dev --webpack",
    "next:start": "next start",
    "dev": "npm run bootstrap && npm run next:dev",
    "start:connected": "npm run dev",
    "start:watch-components": "npm run sitecore-tools:generate-map:watch",
    "start": "next start",
    "start:production": "npm run build && npm run next:start",
    "storybook:prepare": "npm run sitecore-tools:generate-map && sitecore-tools project build --config sitecore.cli.storybook.config.ts",
    "storybook": "npm run storybook:prepare && npm run storybook:start",
    "storybook:start": "storybook dev -p 6006",
    "build-storybook": "npm run storybook:prepare && npm run storybook:build",
    "storybook:build": "storybook build",
    "analyze": "npm run bootstrap && npm run analyze:build",
    "analyze:build": "cross-env ANALYZE=true next build --webpack"
  }
}
