# Non-secret defaults for the XMC-only Content SDK Pages Router application.
# Put real Preview/Live/scoped browser configuration in private .env.local files.
NEXT_PUBLIC_DEFAULT_SITE_NAME=playwebsite
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
GENERATE_STATIC_PATHS=false

# Server-only Edge context; do not copy unrestricted Preview access into public variables.
SITECORE_EDGE_CONTEXT_ID=
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=
SITECORE_EDITING_SECRET=

# Optional local CM/fixture connection. Use only appropriately scoped API credentials.
NEXT_PUBLIC_SITECORE_API_HOST=
NEXT_PUBLIC_SITECORE_API_KEY=
NEXT_PUBLIC_SITECORE_EDGE_PLATFORM_HOSTNAME=
NEXT_PUBLIC_PERSONALIZE_SCOPE=
PERSONALIZE_MIDDLEWARE_EDGE_TIMEOUT=400
PERSONALIZE_MIDDLEWARE_CDP_TIMEOUT=400
