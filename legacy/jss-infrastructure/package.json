{
  "name": "playwebsite",
  "description": "PLAY! Summit XMC rendering host; external integrations are archived",
  "version": "1.0.0",
  "private": true,
  "config": {
    "appName": "playwebsite",
    "rootPlaceholders": [
      "headless-header",
      "headless-main",
      "headless-footer"
    ],
    "sitecoreConfigPath": "/App_Config/Include/zzz",
    "graphQLEndpointPath": "/sitecore/api/graph/edge",
    "language": "en",
    "templates": [
      "nextjs",
      "nextjs-xmcloud",
      "nextjs-sxa",
      "nextjs-multisite"
    ]
  },
  "author": {
    "name": "Sitecore Demo Solutions Team",
    "url": "https://www.sitecore.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sitecore/Sitecore.Demo.XmCloud.PlaySummit.git"
  },
  "bugs": {
    "url": "https://github.com/Sitecore/Sitecore.Demo.XmCloud.PlaySummit/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-brands-svg-icons": "^5.15.4",
    "@fortawesome/free-regular-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@next/bundle-analyzer": "^12.2.4",
    "@sitecore-cloudsdk/core": "^0.4.0",
    "@sitecore-cloudsdk/events": "^0.4.0",
    "@sitecore-feaas/clientside": "^0.5.17",
    "@sitecore-jss/sitecore-jss-nextjs": "~22.2.0",
    "@sitecore/components": "~2.0.0",
    "deep-equal": "^2.0.5",
    "graphql": "~15.8.0",
    "graphql-tag": "^2.12.6",
    "html-react-parser": "^5.1.1",
    "lodash": "^4.17.21",
    "next": "14.2.35",
    "next-localization": "^0.12.0",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^6.0.1",
    "postcss-sassy-mixins": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-loading-skeleton": "^3.0.3",
    "sass": "^1.52.3",
    "sass-alias": "^1.0.5",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/import-types-preset": "^3.0.0",
    "@graphql-codegen/plugin-helpers": "^5.0.1",
    "@graphql-codegen/typed-document-node": "^5.0.1",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-operations": "^4.0.1",
    "@graphql-codegen/typescript-resolvers": "^4.0.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@sitecore-jss/sitecore-jss-cli": "~22.2.0",
    "@sitecore-jss/sitecore-jss-dev-tools": "~22.2.0",
    "@storybook/addon-essentials": "^7.6.15",
    "@storybook/addon-styling": "^1.0.5",
    "@storybook/nextjs": "^7.6.15",
    "@storybook/react": "^7.6.15",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/deep-equal": "^1.0.1",
    "@types/lodash": "^4.14.178",
    "@types/memory-cache": "^0.2.2",
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.0.5",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "autoprefixer": "^10.4.2",
    "chalk": "~4.1.2",
    "chokidar": "~3.5.3",
    "constant-case": "^3.0.4",
    "cross-env": "~7.0.3",
    "dotenv-flow": "^4.1.0",
    "eslint": "^8.32.0",
    "eslint-config-next": "^13.1.5",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.1",
    "eslint-plugin-yaml": "^0.5.0",
    "graphql-let": "^0.18.6",
    "npm-run-all": "~4.1.5",
    "postcss": "^8.4.23",
    "prettier": "^2.8.3",
    "storybook": "^7.6.15",
    "stylelint": "^13.13.1",
    "stylelint-config-standard": "^22.0.0",
    "tailwindcss": "^3.0.23",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.2",
    "typescript": "~4.9.4",
    "yaml-loader": "^0.8.0"
  },
  "scripts": {
    "test:baseline": "playwright test --config=playwright.baseline.config.ts",
    "lint:baseline": "eslint playwright.baseline.config.ts tests/baseline/**/*.ts",
    "DEMO_TEAM_CUSTOMIZATION_EXTRA_SCRIPTS": "",
    "storybook": "npm-run-all --serial bootstrap storybook:start",
    "storybook:start": "storybook dev -p 6006",
    "build-storybook": "npm-run-all --serial bootstrap storybook:build",
    "storybook:build": "storybook build",
    "eslint": "eslint ./src/**/*.tsx ./src/**/*.ts ./scripts/**/*.ts",
    "stylelint": "stylelint ./src/**/*.css",
    "build:local": "npm run build",
    "analyze": "npm-run-all --serial bootstrap analyze:build",
    "analyze:build": "cross-env ANALYZE=true next build",
    "END_CUSTOMIZATION_EXTRA_SCRIPTS": "",
    "install-pre-push-hook": "ts-node --project tsconfig.scripts.json ./scripts/install-pre-push-hook.ts",
    "jss": "jss",
    "DEMO_TEAM_CUSTOMIZATION_LINT": "Run both eslint and stylelint",
    "lint": "npm run eslint && npm run stylelint",
    "END_CUSTOMIZATION_LINT": "",
    "bootstrap": "ts-node --require dotenv-flow/config --project tsconfig.scripts.json scripts/bootstrap.ts",
    "build": "cross-env NODE_ENV=production npm-run-all --serial bootstrap next:build",
    "DEMO_TEAM_CUSTOMIZATION_GRAPHQL_ENDPOINT": "Hardcode the GraphQL endpoint",
    "graphql:update": "cross-env GRAPH_QL_ENDPOINT=https://cm.xmcloudcm.localhost/sitecore/api/graph/edge ts-node --project tsconfig.scripts.json ./scripts/fetch-graphql-introspection-data.ts",
    "END_CUSTOMIZATION_GRAPHQL_ENDPOINT": "",
    "next:build": "next build",
    "next:dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "next:start": "next start",
    "scaffold": "ts-node --project tsconfig.scripts.json scripts/scaffold-component/index.ts",
    "start:connected": "cross-env NODE_ENV=development npm-run-all --serial bootstrap --parallel next:dev start:watch-components",
    "start:production": "cross-env-shell NODE_ENV=production npm-run-all --serial bootstrap next:build next:start",
    "start:watch-components": "ts-node --project tsconfig.scripts.json scripts/generate-component-builder/index.ts --watch"
  }
}
